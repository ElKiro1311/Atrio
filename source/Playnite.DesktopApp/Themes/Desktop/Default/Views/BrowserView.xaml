<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The browser of Atrio: the web without leaving the launcher -->
    <Style TargetType="{x:Type BrowserView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type BrowserView}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource AtrioBrowserBarMargin}">
                            <Button DockPanel.Dock="Left" Style="{DynamicResource AtrioShelfArrow}" Margin="0" Content="&#xE72B;"
                                    ToolTip="{DynamicResource LOCAtrioBrowserBack}" Command="{Binding Browser.BackCommand}" />
                            <Button DockPanel.Dock="Left" Style="{DynamicResource AtrioShelfArrow}" Content="&#xE72A;"
                                    ToolTip="{DynamicResource LOCAtrioBrowserForward}" Command="{Binding Browser.ForwardCommand}" />
                            <Button DockPanel.Dock="Left" Style="{DynamicResource AtrioShelfArrow}" Content="&#xE72C;"
                                    ToolTip="{DynamicResource LOCAtrioBrowserReload}" Command="{Binding Browser.ReloadCommand}" />
                            <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioShelfArrow}" Content="&#xE711;"
                                    ToolTip="{DynamicResource LOCAtrioBrowserClose}" Command="{Binding CloseCommand}" />
                            <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioShelfArrow}" Content="&#xE8A7;"
                                    ToolTip="{DynamicResource LOCAtrioBrowserOutside}" Command="{Binding OpenOutsideCommand}" />
                            <TextBox Margin="10,0,4,0" Height="32" VerticalContentAlignment="Center"
                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding GoCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Height="2">
                            <ProgressBar IsIndeterminate="True" BorderThickness="0" Foreground="{DynamicResource GlyphBrush}"
                                         Visibility="{Binding Browser.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <ContentControl x:Name="PART_BrowserHost" Focusable="False" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
