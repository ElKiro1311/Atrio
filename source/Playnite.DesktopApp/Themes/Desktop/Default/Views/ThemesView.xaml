<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ThemesView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ThemesView}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="34,30,34,32">
                            <DockPanel Margin="0,0,0,20">
                                <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioGhostButton}" VerticalAlignment="Bottom" Margin="0,0,110,4"
                                        Content="{DynamicResource LOCAtrioMoreThemes}" Command="{Binding BrowseThemesCommand}" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCAtrioThemesTitle}" Style="{DynamicResource AtrioPageTitle}" />
                                    <TextBlock Text="{DynamicResource LOCAtrioThemesSubtitle}" Style="{DynamicResource AtrioCaption}"
                                               FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{DynamicResource AtrioCard}" Padding="18,12,18,12" Margin="0,0,14,24" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource LOCAtrioAccentTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <ItemsControl ItemsSource="{Binding Accents}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="{Binding Color}"
                                                        Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType={x:Type ThemesView}}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Ellipse x:Name="Dot" Fill="{Binding Brush}" StrokeThickness="2" Stroke="Transparent" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{DynamicResource AtrioLinkButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Content="{DynamicResource LOCAtrioAccentReset}" Command="{Binding ResetAccentCommand}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Families}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource AtrioSectionTitle}" />
                                            <ItemsControl ItemsSource="{Binding Themes}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,16,16" Cursor="Hand" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ThemesView}}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid Width="372" Height="256">
                                                                        <Border CornerRadius="{DynamicResource AtrioCardRadius}" Background="{DynamicResource NormalBrushDark}" />
                                                                        <Border CornerRadius="{DynamicResource AtrioCardRadius}">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding PreviewPath, Converter={StaticResource ImageStringToImageConverter}, IsAsync=True}"
                                                                                            Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Top" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <!-- The name lives on the preview, over a soft shadow -->
                                                                        <Border CornerRadius="{DynamicResource AtrioCardRadius}">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#00000000" Offset="0.4" />
                                                                                    <GradientStop Color="#F2000000" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                                                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="White"
                                                                                       FontFamily="{DynamicResource AtrioDisplayFont}" />
                                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#D9FFFFFF" TextWrapping="Wrap"
                                                                                       FontFamily="{DynamicResource FontFamily}" Margin="0,2,0,0" />
                                                                        </StackPanel>
                                                                        <Border x:Name="InUse" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" CornerRadius="6"
                                                                                Background="{DynamicResource GlyphBrush}" Padding="9,3,9,4" Visibility="Collapsed">
                                                                            <TextBlock Text="{DynamicResource LOCAtrioCurrentTheme}" FontSize="12" FontWeight="SemiBold"
                                                                                       FontFamily="{DynamicResource FontFamily}" Foreground="{DynamicResource AtrioPlayTextBrush}" />
                                                                        </Border>
                                                                        <Border x:Name="Apply" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" CornerRadius="6"
                                                                                Background="#CC000000" Padding="9,3,9,4" Visibility="Collapsed">
                                                                            <TextBlock Text="{DynamicResource LOCAtrioApplyTheme}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                                                       FontFamily="{DynamicResource FontFamily}" />
                                                                        </Border>
                                                                        <Border x:Name="Ring" CornerRadius="{DynamicResource AtrioCardRadius}" BorderThickness="2" BorderBrush="{DynamicResource AtrioBorderBrush}" />
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                                                                            <Setter TargetName="Apply" Property="Visibility" Value="Visible" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                                                                            <Setter TargetName="InUse" Property="Visibility" Value="Visible" />
                                                                            <Setter TargetName="Apply" Property="Opacity" Value="0" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
