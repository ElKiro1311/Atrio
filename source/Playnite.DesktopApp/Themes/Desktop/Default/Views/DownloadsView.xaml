<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Small square picture of a game: its icon, or nothing -->
    <DataTemplate x:Key="AtrioDownloadsIcon">
        <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource AtrioCardHoverBrush}">
            <Image Source="{Binding IconObjectCached, Mode=OneWay}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
    </DataTemplate>

    <Style TargetType="{x:Type DownloadsView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DownloadsView}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="34,30,34,32">
                            <DockPanel Margin="0,0,0,22">
                                <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioGhostButton}" VerticalAlignment="Bottom"
                                        Margin="{DynamicResource AtrioPageCornerMargin}" Command="{Binding RefreshCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource AtrioIconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource LOCAtrioStorageRefresh}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCAtrioDownloadsTitle}" Style="{DynamicResource AtrioPageTitle}" />
                                    <TextBlock Text="{DynamicResource LOCAtrioDownloadsSubtitle}" Style="{DynamicResource AtrioCaption}"
                                               FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- What is installing now, from any store -->
                            <TextBlock Text="{DynamicResource LOCAtrioDownloadsNow}" Style="{DynamicResource AtrioSectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource LOCAtrioDownloadsNothing}" Style="{DynamicResource AtrioCaption}" FontSize="13" Margin="0,0,0,22"
                                       Visibility="{Binding HasActive, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Active}" Focusable="False" Margin="0,0,14,18"
                                          Visibility="{Binding Active, Converter={StaticResource ICollectionNullOrEmptyToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource AtrioCard}" Padding="14,12,16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding Entry}" ContentTemplate="{StaticResource AtrioDownloadsIcon}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{DynamicResource AtrioCaption}" Margin="12,0,0,0" />
                                                        <TextBlock Text="{Binding Game.Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="15"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding StoreName}" Style="{DynamicResource AtrioCaption}" Margin="0,1,0,0" />
                                                    <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                                 Foreground="{DynamicResource GlyphBrush}" Background="{DynamicResource AtrioCardHoverBrush}" BorderThickness="0"
                                                                 Visibility="{Binding HasPercent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{DynamicResource AtrioGhostButton}" VerticalAlignment="Center"
                                                        Content="{DynamicResource LOCAtrioDownloadsOpenGame}" CommandParameter="{Binding Game}"
                                                        Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- A list being uninstalled: which game goes now, and a way to stop the rest -->
                            <Border Style="{DynamicResource AtrioCard}" Padding="16,10,12,10" Margin="0,0,14,14"
                                    Visibility="{Binding IsRemoving, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioStorageStop}"
                                            Command="{Binding StopRemovalCommand}" />
                                    <TextBlock Text="{Binding RemovalText}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                                </DockPanel>
                            </Border>

                            <!-- Games waiting to install, one after the other -->
                            <StackPanel Margin="0,0,14,18" Visibility="{Binding HasQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="{DynamicResource LOCAtrioQueueStartAt}" IsChecked="{Binding StartLater}" VerticalAlignment="Center"
                                                  ToolTip="{DynamicResource LOCAtrioQueueStartAtHint}" />
                                        <ComboBox ItemsSource="{Binding Hours}" SelectedIndex="{Binding StartHour}" MinWidth="80" Margin="8,0,12,0" VerticalAlignment="Center" />
                                        <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioQueueClear}" Command="{Binding QueueClearCommand}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCAtrioQueueTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                                        <TextBlock Text="{Binding QueueText}" Style="{DynamicResource AtrioCaption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Queue}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource AtrioCard}" Padding="14,10,12,10" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{DynamicResource AtrioShelfArrow}" Width="28" Height="28" Content="&#xE70E;" Margin="0,0,4,0"
                                                                ToolTip="{DynamicResource LOCAtrioQueueUp}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.QueueUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                                        <Button Style="{DynamicResource AtrioShelfArrow}" Width="28" Height="28" Content="&#xE70D;" Margin="0,0,10,0"
                                                                ToolTip="{DynamicResource LOCAtrioQueueDown}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.QueueDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                                        <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioQueueRemove}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.QueueRemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                                    </StackPanel>
                                                    <ContentPresenter Content="{Binding Entry}" ContentTemplate="{StaticResource AtrioDownloadsIcon}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                    <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{DynamicResource AtrioCaption}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding StoreName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Games of Steam with an update waiting, before sitting down to play -->
                            <StackPanel Margin="0,0,14,18" Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioUpdatesOpenSteam}"
                                            VerticalAlignment="Center" Command="{Binding OpenSteamDownloadsCommand}" />
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCAtrioUpdatesTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                                        <TextBlock Text="{DynamicResource LOCAtrioUpdatesHint}" Style="{DynamicResource AtrioCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Updates}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource AtrioCard}" Padding="14,10,12,10" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <ContentPresenter Content="{Binding Entry}" ContentTemplate="{StaticResource AtrioDownloadsIcon}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                    <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StateText}" Style="{DynamicResource AtrioCaption}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The room of each disk, with its games by size -->
                            <DockPanel Margin="0,4,14,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectionText}" Style="{DynamicResource AtrioCaption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioStorageClear}" Margin="0,0,8,0"
                                            Command="{Binding ClearSelectionCommand}" />
                                    <Button Style="{DynamicResource AtrioPlayButton}" Padding="18,0,18,0" Content="{DynamicResource LOCAtrioStorageUninstallSelected}"
                                            Command="{Binding UninstallSelectedCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCAtrioStorageTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                                    <TextBlock Text="{DynamicResource LOCAtrioStorageHint}" Style="{DynamicResource AtrioCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <CheckBox Content="{DynamicResource LOCAtrioStorageForgotten}" IsChecked="{Binding OnlyForgotten}" Margin="0,8,0,0"
                                              ToolTip="{DynamicResource LOCAtrioStorageForgottenHint}" />
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Disks}" Focusable="False" Margin="0,0,14,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource AtrioCard}" Padding="18,16,18,10" Margin="0,0,0,14">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,10">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Style="{DynamicResource AtrioCaption}" FontSize="13" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="17" FontWeight="SemiBold" />
                                                </DockPanel>

                                                <!-- One whole: games, everything else and free room -->
                                                <Grid Height="14" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding GamesLength}" />
                                                        <ColumnDefinition Width="{Binding OtherLength}" />
                                                        <ColumnDefinition Width="{Binding FreeLength}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Margin="0,0,2,0" Background="{DynamicResource GlyphBrush}" />
                                                    <Border Grid.Column="1" CornerRadius="4" Margin="0,0,2,0" Background="{DynamicResource TextBrushDarker}" Opacity="0.45" />
                                                    <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource AtrioCardHoverBrush}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource GlyphBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding GamesLegend}" Style="{DynamicResource AtrioCaption}" Margin="6,0,18,0" VerticalAlignment="Center" />
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource TextBrushDarker}" Opacity="0.45" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding OtherLegend}" Style="{DynamicResource AtrioCaption}" Margin="6,0,18,0" VerticalAlignment="Center" />
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AtrioCardHoverBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FreeLegend}" Style="{DynamicResource AtrioCaption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="{DynamicResource LOCAtrioStorageNoGames}" Style="{DynamicResource AtrioCaption}" Margin="0,2,0,6"
                                                           Visibility="{Binding HasRows, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Row" CornerRadius="6" Padding="6,5,6,5" Background="Transparent">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                              AutomationProperties.Name="{Binding Game.Name}" />
                                                                    <ContentPresenter Grid.Column="1" Content="{Binding Entry}" ContentTemplate="{StaticResource AtrioDownloadsIcon}" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Game.Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                                                        <TextBlock Text="{Binding StoreName}" Style="{DynamicResource AtrioCaption}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" Style="{DynamicResource AtrioCaption}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioStorageOpenFolder}" Margin="0,0,6,0"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                                                        <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioStorageUninstall}"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- What stayed behind after a game went away: folders, shaders, the Workshop, downloads halfway -->
                            <StackPanel Margin="0,10,14,0" Visibility="{Binding HasLeftovers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioPlayButton}" Padding="18,0,18,0" VerticalAlignment="Center"
                                            Content="{DynamicResource LOCAtrioLeftoverRecycle}" Command="{Binding RecycleLeftoversCommand}" />
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCAtrioLeftoverTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                                        <TextBlock Text="{DynamicResource LOCAtrioLeftoverHint}" Style="{DynamicResource AtrioCaption}" TextWrapping="Wrap" Margin="0,2,12,0" />
                                        <TextBlock Text="{Binding LeftoverText}" Style="{DynamicResource AtrioCaption}" FontSize="13" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{DynamicResource AtrioCard}" Padding="12,8,12,8">
                                    <ItemsControl ItemsSource="{Binding Leftovers}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" CornerRadius="6" Padding="6,5,6,5" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                  AutomationProperties.Name="{Binding Name}" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                            <TextBlock Text="{Binding KindText}" Style="{DynamicResource AtrioCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding LastUsedText}" Style="{DynamicResource AtrioCaption}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                        <Button Grid.Column="4" Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioStorageOpenFolder}"
                                                                VerticalAlignment="Center" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.OpenLeftoverCommand, RelativeSource={RelativeSource AncestorType={x:Type DownloadsView}}}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
