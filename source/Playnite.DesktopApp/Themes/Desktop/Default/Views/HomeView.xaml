<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Arrow that moves a shelf -->
    <Style x:Key="AtrioShelfArrow" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource AtrioIconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="16" Background="{DynamicResource AtrioCardBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- First card of a shelf: the art fills it and says how the game is going -->
    <Style x:Key="AtrioLeadTile" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="400" Height="224">
                        <Border CornerRadius="{DynamicResource AtrioCardRadius}" Background="{DynamicResource AtrioCardBrush}" />
                        <Border CornerRadius="{DynamicResource AtrioCardRadius}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Game.WideCardImageObjectCached, IsAsync=True}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="{DynamicResource AtrioCardRadius}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.4" />
                                    <GradientStop Color="#E6000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,14,12">
                            <TextBlock Text="{Binding Game.DisplayName}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource AtrioDisplayFont}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Caption}" Foreground="#CCFFFFFF" FontSize="12" FontFamily="{DynamicResource FontFamily}"
                                       Visibility="{Binding Caption, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            <TextBlock Text="{Binding RecentText}" Foreground="#CCFFFFFF" FontSize="12" FontFamily="{DynamicResource FontFamily}"
                                       Visibility="{Binding RecentText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            <TextBlock Text="{Binding TotalText}" Foreground="#CCFFFFFF" FontSize="12" FontFamily="{DynamicResource FontFamily}"
                                       Visibility="{Binding TotalText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        </StackPanel>
                        <Border x:Name="Outline" CornerRadius="{DynamicResource AtrioCardRadius}" BorderThickness="2" BorderBrush="#1AFFFFFF" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AtrioShelfTemplate">
        <StackPanel Margin="0,0,0,24">
            <DockPanel Margin="0,0,28,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76B;"
                            Command="ScrollBar.PageLeftCommand" CommandTarget="{Binding ElementName=Scroller}" />
                    <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76C;"
                            Command="ScrollBar.PageRightCommand" CommandTarget="{Binding ElementName=Scroller}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                    <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource AtrioCaption}"
                               Visibility="{Binding Subtitle, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PageWheel.PassToParent="True" Focusable="False">
                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding GroupLabel}" Style="{DynamicResource AtrioCaption}" Height="18" />
                                <Grid>
                                    <Button Style="{DynamicResource AtrioLeadTile}"
                                            Visibility="{Binding IsWide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            CommandParameter="{Binding Game}"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}" />
                                    <Grid Visibility="{Binding IsWide, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                        <Button Style="{DynamicResource AtrioGameTile}" DataContext="{Binding Game}"
                                                ToolTip="{Binding DisplayName}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}" />
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Padding="10,2,10,2" CornerRadius="0,0,6,6"
                                                Background="{DynamicResource GlyphBrush}"
                                                Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource LOCAtrioNewToLibrary}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AtrioPlayTextBrush}" FontFamily="{DynamicResource FontFamily}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type HomeView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type HomeView}">
                    <Grid>
                        <!-- First start without games -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource LOCAtrioHomeEmpty}" Style="{DynamicResource AtrioCaption}" FontSize="15" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Style="{DynamicResource AtrioPlayButton}" Margin="0,18,0,0" HorizontalAlignment="Center" Padding="26,0,26,0"
                                    Content="{DynamicResource LOCAtrioConnectStores}" Command="{Binding OpenStoresCommand}" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                            <StackPanel Margin="{DynamicResource AtrioHomeMargin}">
                                <!-- News of the games played last -->
                                <StackPanel Margin="0,0,0,24" Visibility="{Binding News, Converter={StaticResource ICollectionNullOrEmptyToVisibilityConverter}}">
                                    <DockPanel Margin="0,0,28,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76B;"
                                                    Command="ScrollBar.PageLeftCommand" CommandTarget="{Binding ElementName=NewsScroller}" />
                                            <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76C;"
                                                    Command="ScrollBar.PageRightCommand" CommandTarget="{Binding ElementName=NewsScroller}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource LOCAtrioHomeNews}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ScrollViewer x:Name="NewsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  PageWheel.PassToParent="True" Focusable="False">
                                        <ItemsControl ItemsSource="{Binding News}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="300" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding GroupLabel}" Style="{DynamicResource AtrioCaption}" Height="18" />
                                                        <Button Cursor="Hand" Focusable="False" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel>
                                                                <Border CornerRadius="{DynamicResource AtrioCardRadius}" Height="140" ClipToBounds="True" Background="{DynamicResource AtrioCardBrush}">
                                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource RemoteImageConverter}, ConverterParameter=600}"
                                                                           Stretch="UniformToFill" RoundedClip.Radius="{DynamicResource AtrioCoverRadius}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="13" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" />
                                                                <TextBlock Text="{Binding GameName}" Style="{DynamicResource AtrioCaption}" TextTrimming="CharacterEllipsis" Margin="2,1,2,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{DynamicResource AtrioShelfTemplate}" Focusable="False" />

                                <!-- The start of the whole library. Everything else is one click away -->
                                <DockPanel Margin="0,0,28,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCAtrioHomeSortBy}" Style="{DynamicResource AtrioCaption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="150" SelectedIndex="{Binding AllGamesSort}" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortName}" />
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortPlaytime}" />
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortRecent}" />
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortAdded}" />
                                        </ComboBox>
                                        <Button Style="{DynamicResource AtrioGhostButton}" Margin="10,0,0,0" MinHeight="32" Padding="12,0,12,0"
                                                Content="{DynamicResource LOCAtrioHomeSeeAll}" Command="{MainViewModel ShowAllGamesCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AllGamesTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding AllGames}" Focusable="False" Margin="0,0,14,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource AtrioGameTile}" Margin="0,0,14,14"
                                                    ToolTip="{Binding DisplayName}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
