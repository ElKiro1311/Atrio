<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Arrow that moves a shelf -->
    <Style x:Key="AtrioShelfArrow" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource AtrioIconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="16" Background="{DynamicResource AtrioCardBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- First card of a shelf: the art fills it and says how the game is going -->
    <Style x:Key="AtrioLeadTile" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="400" Height="224">
                        <Border CornerRadius="{DynamicResource AtrioCardRadius}" Background="{DynamicResource AtrioCardBrush}" />
                        <Border CornerRadius="{DynamicResource AtrioCardRadius}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Game.WideCardImageObjectCached, IsAsync=True}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="{DynamicResource AtrioCardRadius}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.4" />
                                    <GradientStop Color="#E6000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,14,12">
                            <TextBlock Text="{Binding Game.DisplayName}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource AtrioDisplayFont}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Caption}" Foreground="#CCFFFFFF" FontSize="12" FontFamily="{DynamicResource FontFamily}"
                                       Visibility="{Binding Caption, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            <TextBlock Text="{Binding RecentText}" Foreground="#CCFFFFFF" FontSize="12" FontFamily="{DynamicResource FontFamily}"
                                       Visibility="{Binding RecentText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            <TextBlock Text="{Binding TotalText}" Foreground="#CCFFFFFF" FontSize="12" FontFamily="{DynamicResource FontFamily}"
                                       Visibility="{Binding TotalText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        </StackPanel>
                        <Border x:Name="Outline" CornerRadius="{DynamicResource AtrioCardRadius}" BorderThickness="2" BorderBrush="#1AFFFFFF" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AtrioShelfTemplate">
        <StackPanel Margin="0,0,0,24">
            <DockPanel Margin="0,0,28,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource AtrioLinkButton}" Content="{DynamicResource LOCAtrioHomeSeeAll}" Margin="0,0,6,0" VerticalAlignment="Center"
                            CommandParameter="{Binding}"
                            Command="{Binding DataContext.OpenShelfCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}"
                            Visibility="{Binding HasCollection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76B;"
                            Command="ScrollBar.PageLeftCommand" CommandTarget="{Binding ElementName=Scroller}" />
                    <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76C;"
                            Command="ScrollBar.PageRightCommand" CommandTarget="{Binding ElementName=Scroller}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                    <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource AtrioCaption}"
                               Visibility="{Binding Subtitle, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PageWheel.PassToParent="True" Focusable="False">
                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding GroupLabel}" Style="{DynamicResource AtrioCaption}" Height="18" />
                                <Grid>
                                    <Button Style="{DynamicResource AtrioLeadTile}"
                                            Visibility="{Binding IsWide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            CommandParameter="{Binding Game}"
                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}" />
                                    <Grid Visibility="{Binding IsWide, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                        <Button Style="{DynamicResource AtrioGameTile}" DataContext="{Binding Game}"
                                                ToolTip="{Binding DisplayName}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}" />
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Padding="10,2,10,2" CornerRadius="0,0,6,6"
                                                Background="{DynamicResource GlyphBrush}"
                                                Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource LOCAtrioNewToLibrary}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AtrioPlayTextBrush}" FontFamily="{DynamicResource FontFamily}" />
                                        </Border>
                                        <!-- A short note at the foot of the cover, like how many achievements are left -->
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="10,3,10,3" CornerRadius="6,6,0,0"
                                                Background="#D9101218" IsHitTestVisible="False"
                                                Visibility="{Binding BadgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                       FontFamily="{DynamicResource FontFamily}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type HomeView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type HomeView}">
                    <Grid>
                        <!-- First start without games -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource LOCAtrioHomeEmpty}" Style="{DynamicResource AtrioCaption}" FontSize="15" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Style="{DynamicResource AtrioPlayButton}" Margin="0,18,0,0" HorizontalAlignment="Center" Padding="26,0,26,0"
                                    Content="{DynamicResource LOCAtrioConnectStores}" Command="{Binding OpenStoresCommand}" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                            <StackPanel Margin="{DynamicResource AtrioHomeMargin}">
                                <!-- The week in numbers: the time played, by day and by game -->
                                <Border Margin="0,0,28,24" Padding="24,18,24,18" CornerRadius="{DynamicResource AtrioCardRadius}"
                                        Background="{DynamicResource AtrioCardBrush}" DataContext="{Binding Week}"
                                        Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="210" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                            <TextBlock Text="{DynamicResource LOCAtrioWeekTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" />
                                            <TextBlock Text="{Binding RangeText}" Style="{DynamicResource AtrioCaption}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding TotalText}" Style="{DynamicResource BaseTextBlockStyle}"
                                                       FontSize="48" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding CompareText}" Style="{DynamicResource AtrioCaption}"
                                                       Visibility="{Binding CompareText, Converter={StaticResource NullToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <StackPanel Margin="0,0,28,0">
                                                    <TextBlock Text="{Binding GamesValue}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="20" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding GamesLabel}" Style="{DynamicResource AtrioCaption}" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding AchievementsValue, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding AchievementsValue}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="20" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AchievementsLabel}" Style="{DynamicResource AtrioCaption}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- One column per day, from the same baseline -->
                                        <StackPanel Grid.Column="1" Margin="36,6,40,0" VerticalAlignment="Bottom">
                                            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="40" Background="Transparent" ToolTip="{Binding ToolTip}"
                                                                    AutomationProperties.Name="{Binding ToolTip}">
                                                            <Grid Height="96">
                                                                <Border Width="20" Height="{Binding BarHeight}" VerticalAlignment="Bottom"
                                                                        CornerRadius="4,4,0,0" Background="{DynamicResource GlyphBrush}" />
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource AtrioBorderBrush}" />
                                                            <TextBlock x:Name="DayName" Text="{Binding Label}" Style="{DynamicResource AtrioCaption}"
                                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter TargetName="DayName" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                <Setter TargetName="DayName" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                <Setter TargetName="DayName" Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- The games played most, each with a bar as long as its time -->
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Games}" Focusable="False" VerticalAlignment="Center" MaxWidth="900"
                                                      HorizontalAlignment="Right" MinWidth="320">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" Focusable="False" Margin="0,3,0,3" CommandParameter="{Binding Game}"
                                                            ToolTip="{Binding Game.DisplayName}"
                                                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource AtrioCardHoverBrush}">
                                                                <Image Source="{Binding Game.IconObjectCached, Mode=OneWay}" Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Game.DisplayName}" Style="{DynamicResource BaseTextBlockStyle}"
                                                                           FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <Grid Height="6" Margin="0,5,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding BarLength}" />
                                                                        <ColumnDefinition Width="{Binding RestLength}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border CornerRadius="0,3,3,0" Background="{DynamicResource GlyphBrush}" />
                                                                </Grid>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{DynamicResource AtrioCaption}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- News of the games played last -->
                                <StackPanel Margin="0,0,0,24" Visibility="{Binding News, Converter={StaticResource ICollectionNullOrEmptyToVisibilityConverter}}">
                                    <DockPanel Margin="0,0,28,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76B;"
                                                    Command="ScrollBar.PageLeftCommand" CommandTarget="{Binding ElementName=NewsScroller}" />
                                            <Button Style="{DynamicResource AtrioShelfArrow}" Content="&#xE76C;"
                                                    Command="ScrollBar.PageRightCommand" CommandTarget="{Binding ElementName=NewsScroller}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource LOCAtrioHomeNews}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ScrollViewer x:Name="NewsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  PageWheel.PassToParent="True" Focusable="False">
                                        <ItemsControl ItemsSource="{Binding News}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="300" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding GroupLabel}" Style="{DynamicResource AtrioCaption}" Height="18" />
                                                        <Button Cursor="Hand" Focusable="False" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel>
                                                                <Border CornerRadius="{DynamicResource AtrioCardRadius}" Height="140" ClipToBounds="True" Background="{DynamicResource AtrioCardBrush}">
                                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource RemoteImageConverter}, ConverterParameter=600}"
                                                                           Stretch="UniformToFill" RoundedClip.Radius="{DynamicResource AtrioCoverRadius}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="13" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" />
                                                                <TextBlock Text="{Binding GameName}" Style="{DynamicResource AtrioCaption}" TextTrimming="CharacterEllipsis" Margin="2,1,2,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{DynamicResource AtrioShelfTemplate}" Focusable="False" />

                                <!-- The start of the whole library. Everything else is one click away -->
                                <DockPanel Margin="0,0,28,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCAtrioHomeSortBy}" Style="{DynamicResource AtrioCaption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="150" SelectedIndex="{Binding AllGamesSort}" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortName}" />
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortPlaytime}" />
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortRecent}" />
                                            <ComboBoxItem Content="{DynamicResource LOCAtrioHomeSortAdded}" />
                                        </ComboBox>
                                        <Button Style="{DynamicResource AtrioGhostButton}" Margin="10,0,0,0" MinHeight="32" Padding="12,0,12,0"
                                                Content="{DynamicResource LOCAtrioHomeSeeAll}" Command="{MainViewModel ShowAllGamesCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AllGamesTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding AllGames}" Focusable="False" Margin="0,0,14,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource AtrioGameTile}" Margin="0,0,14,14"
                                                    ToolTip="{Binding DisplayName}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType={x:Type HomeView}}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
