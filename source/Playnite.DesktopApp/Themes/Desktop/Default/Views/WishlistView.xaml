<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The price of a game: the offer first, the price before it crossed out, and the price now -->
    <DataTemplate x:Key="AtrioWishPrice">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,0" Background="{DynamicResource AtrioPlayBrush}" VerticalAlignment="Center"
                    Visibility="{Binding OnSale, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding DiscountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AtrioPlayTextBrush}" />
            </Border>
            <TextBlock Text="{Binding BasePriceText}" Style="{DynamicResource AtrioCaption}" TextDecorations="Strikethrough" VerticalAlignment="Center" Margin="0,0,8,0"
                       Visibility="{Binding OnSale, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding PriceText}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type WishlistView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WishlistView}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="34,30,34,32">
                            <DockPanel Margin="0,0,0,20">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="{DynamicResource AtrioPageCornerMargin}">
                                    <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioWishImport}" Margin="0,0,8,0"
                                            Command="{Binding ImportSteamCommand}" ToolTip="{DynamicResource LOCAtrioWishImportHint}" />
                                    <Button Style="{DynamicResource AtrioGhostButton}" Command="{Binding RefreshCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource AtrioIconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource LOCAtrioWishRefresh}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCAtrioWishTitle}" Style="{DynamicResource AtrioPageTitle}" />
                                    <TextBlock Text="{DynamicResource LOCAtrioWishSubtitle}" Style="{DynamicResource AtrioCaption}"
                                               FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Search in Steam and GOG -->
                            <DockPanel Margin="0,0,14,8">
                                <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioWishClear}" Margin="8,0,0,0"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button DockPanel.Dock="Right" Style="{DynamicResource AtrioPlayButton}" Padding="18,0,18,0" Margin="8,0,0,0"
                                        Content="{DynamicResource LOCAtrioWishSearch}" Command="{Binding SearchCommand}" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6,8,6" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{DynamicResource LOCAtrioWishSearchHint}" ToolTip="{DynamicResource LOCAtrioWishSearchHint}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource AtrioCaption}" FontSize="13" Margin="0,0,14,10" TextWrapping="Wrap"
                                       Visibility="{Binding StatusText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

                            <Border Style="{DynamicResource AtrioCard}" Padding="14,10,14,10" Margin="0,0,14,22"
                                    Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="6" Padding="6,5,6,5" Background="Transparent">
                                                <DockPanel>
                                                    <Button x:Name="Add" DockPanel.Dock="Right" Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioWishAdd}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType={x:Type WishlistView}}}" />
                                                    <TextBlock x:Name="Added" DockPanel.Dock="Right" Text="{DynamicResource LOCAtrioWishInList}" Style="{DynamicResource AtrioCaption}"
                                                               VerticalAlignment="Center" Margin="12,0,6,0" Visibility="Collapsed" />
                                                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource AtrioWishPrice}" Margin="12,0,0,0" />
                                                    <Border Width="120" Height="45" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource AtrioCardHoverBrush}" DockPanel.Dock="Left">
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource RemoteImageConverter}, ConverterParameter=240}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StoreName}" Style="{DynamicResource AtrioCaption}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding InList}" Value="True">
                                                    <Setter TargetName="Add" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Added" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- The list: what is on sale first -->
                            <TextBlock Text="{DynamicResource LOCAtrioWishListTitle}" Style="{DynamicResource AtrioSectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource LOCAtrioWishEmpty}" Style="{DynamicResource AtrioCaption}" FontSize="13" TextWrapping="Wrap" Margin="0,0,14,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,0,14,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource AtrioCard}" Padding="12" Margin="0,0,0,10">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioWishOpen}" Margin="0,0,6,0"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type WishlistView}}}" />
                                                    <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioWishRemove}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type WishlistView}}}" />
                                                </StackPanel>
                                                <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource AtrioWishPrice}" />
                                                <Border Width="184" Height="69" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource AtrioCardHoverBrush}" DockPanel.Dock="Left">
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource RemoteImageConverter}, ConverterParameter=368}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StoreName}" Style="{DynamicResource AtrioCaption}" />
                                                    <TextBlock Text="{Binding DetailText}" Style="{DynamicResource AtrioCaption}" TextWrapping="Wrap"
                                                               Visibility="{Binding DetailText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
