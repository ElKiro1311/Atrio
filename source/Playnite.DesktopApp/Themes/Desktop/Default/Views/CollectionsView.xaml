<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A cover of the fan of a collection -->
    <Style x:Key="AtrioCollectionCover" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource AtrioCardRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#30000000" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A collection: the games it starts with, its name and how many it has -->
    <Style x:Key="AtrioCollectionTile" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="224" Height="288">
                        <Border x:Name="Root" CornerRadius="{DynamicResource AtrioCardRadius}" Background="{DynamicResource AtrioCardBrush}" />

                        <Grid Margin="0,14,0,62">
                            <Border Style="{DynamicResource AtrioCollectionCover}" Width="104" Height="140" HorizontalAlignment="Left" Margin="12,0,0,0"
                                    RenderTransformOrigin="0.5,0.9" Opacity="0.75"
                                    Visibility="{Binding HasLeftCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-7" />
                                </Border.RenderTransform>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding LeftCover.GridViewCoverObjectCached, IsAsync=True}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Style="{DynamicResource AtrioCollectionCover}" Width="104" Height="140" HorizontalAlignment="Right" Margin="0,0,12,0"
                                    RenderTransformOrigin="0.5,0.9" Opacity="0.75"
                                    Visibility="{Binding HasRightCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="7" />
                                </Border.RenderTransform>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding RightCover.GridViewCoverObjectCached, IsAsync=True}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Style="{DynamicResource AtrioCollectionCover}" Width="132" Height="176" HorizontalAlignment="Center"
                                    Visibility="{Binding HasFrontCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding FrontCover.GridViewCoverObjectCached, IsAsync=True}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding IconText}" FontFamily="{DynamicResource AtrioIconFont}" FontSize="54"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrushDarker}"
                                       Visibility="{Binding HasFrontCover, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                        </Grid>

                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource AtrioIconFont}" FontSize="13" Margin="0,10,10,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource GlyphBrush}"
                                   ToolTip="{DynamicResource LOCAtrioCollectionDynamicTag}"
                                   Visibility="{Binding IsDynamic, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                            <TextBlock x:Name="Name" Text="{Binding Collection.Name}" Style="{DynamicResource BaseTextBlockStyle}"
                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CountText}" Style="{DynamicResource AtrioCaption}" />
                        </StackPanel>

                        <Border x:Name="Outline" CornerRadius="{DynamicResource AtrioCardRadius}" BorderThickness="2" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                            <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AtrioCardHoverBrush}" />
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CollectionsView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CollectionsView}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Background="Transparent">
                        <StackPanel Margin="{DynamicResource AtrioHomeMargin}">
                            <DockPanel Margin="0,0,28,4">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource AtrioGhostButton}" MinHeight="32" Padding="12,0,12,0" Margin="0,0,8,0"
                                            Content="{DynamicResource LOCAtrioCollectionNewDynamic}" Command="{Binding NewDynamicCollectionCommand}"
                                            Visibility="{Binding HasLibraryPanes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Style="{DynamicResource AtrioPlayButton}" MinHeight="32" Padding="14,0,14,0"
                                            Content="{DynamicResource LOCAtrioCollectionNew}" Command="{Binding NewCollectionCommand}" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource LOCAtrioCollections}" Style="{DynamicResource AtrioSectionTitle}"
                                           FontSize="22" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{DynamicResource LOCAtrioCollectionsHint}" Style="{DynamicResource AtrioCaption}" Margin="0,0,28,16"
                                       TextWrapping="Wrap" Visibility="{Binding HasLibraryPanes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource AtrioCollectionTile}" Margin="0,0,14,14" ToolTip="{Binding Collection.Name}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type CollectionsView}}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Over the games of the library: the collection that is open, or the filters of a dynamic one -->
    <DataTemplate x:Key="AtrioCollectionBar">
        <StackPanel>
            <DockPanel Margin="16,10,20,8" Visibility="{Binding HasActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button DockPanel.Dock="Left" Style="{DynamicResource AtrioShelfArrow}" Content="&#xE72B;" Margin="0,0,12,0"
                        ToolTip="{DynamicResource LOCAtrioCollections}" Command="{Binding BackCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{DynamicResource AtrioGhostButton}" MinHeight="32" Padding="12,0,12,0"
                            Content="{DynamicResource LOCAtrioCollectionChooseGames}" Command="{Binding ChooseGamesCommand}"
                            Visibility="{Binding CanChooseGames, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Style="{DynamicResource AtrioGhostButton}" MinHeight="32" Padding="10,0,10,0" Margin="8,0,0,0"
                            Content="&#xE712;" FontFamily="{DynamicResource AtrioIconFont}" ToolTip="{DynamicResource LOCAtrioMore}"
                            Command="{Binding MoreCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveName}" Style="{DynamicResource AtrioSectionTitle}" Margin="0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ActiveDetails}" Style="{DynamicResource AtrioCaption}" />
                </StackPanel>
            </DockPanel>

            <!-- In two rows: with the panel of filters open, the window can leave little room -->
            <StackPanel Margin="16,10,20,8" Visibility="{Binding IsDrafting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding DraftText}" Style="{DynamicResource AtrioCaption}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Style="{DynamicResource AtrioGhostButton}" MinHeight="32" Padding="12,0,12,0" Margin="0,0,8,0"
                            Content="{DynamicResource LOCCancelLabel}" Command="{Binding CancelDraftCommand}" />
                    <Button Style="{DynamicResource AtrioPlayButton}" MinHeight="32" Padding="14,0,14,0"
                            Content="{DynamicResource LOCAtrioCollectionSave}" Command="{Binding SaveFiltersCommand}"
                            IsEnabled="{Binding CanSaveFilters}" />
                </StackPanel>
            </StackPanel>

            <Button Style="{DynamicResource AtrioLinkButton}" HorizontalAlignment="Left" Margin="20,8,0,2"
                    Content="{DynamicResource LOCAtrioCollectionSaveFilters}" Command="{Binding SaveFiltersCommand}"
                    Visibility="{Binding OffersSavingFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
