<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.CaptureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
        mc:Ignorable="d"
        d:DesignStyle="{StaticResource WindowDesignStyle}"
        Style="{DynamicResource StandardWindowStyle}"
        Title="{Binding WindowTitle}" Height="820" Width="1360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource WindowPanelSeparatorBrush}">
            <DockPanel LastChildFill="True" Margin="5">
                <Button Content="{DynamicResource LOCCloseLabel}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" />
                <Button Content="{DynamicResource LOCAtrioCapturesFolder}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" />
                <Button Content="{DynamicResource LOCAtrioCapturesPlay}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Right" Command="{Binding PlayCommand}"
                        Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding InfoText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Background="#FF0B0C10">
            <Image Source="{Binding Picture}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="56,12,56,12" />

            <!-- A clip shows its frame with a play sign: a click opens it in the player of Windows -->
            <Button Width="88" Height="88" Cursor="Hand" Focusable="False" Command="{Binding PlayCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{DynamicResource LOCAtrioCapturesPlay}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" CornerRadius="44" Background="#B0000000">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#E0000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Height="64" Cursor="Hand" Focusable="False"
                    Command="{Binding PreviousCommand}" AutomationProperties.Name="{DynamicResource LOCAtrioCapturesPrevious}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="8" Background="#60000000">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#A0000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Back" Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="40" Height="64" Cursor="Hand" Focusable="False"
                    Command="{Binding NextCommand}" AutomationProperties.Name="{DynamicResource LOCAtrioCapturesNext}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="8" Background="#60000000">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#A0000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Back" Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </DockPanel>
</controls:WindowBase>
