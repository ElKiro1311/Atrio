<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.SteamCardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
        mc:Ignorable="d"
        d:DesignStyle="{StaticResource WindowDesignStyle}"
        Style="{DynamicResource StandardWindowStyle}"
        Title="{Binding WindowTitle}" Height="820" Width="1180"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource WindowPanelSeparatorBrush}">
            <DockPanel LastChildFill="False" Margin="5">
                <Button Content="{DynamicResource LOCCloseLabel}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" />
                <Button Content="{DynamicResource LOCAtrioCardsPage}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Left" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding Panel.PageUrl}" />
                <Button Content="{DynamicResource LOCAtrioCardsMarket}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Left" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding Panel.MarketUrl}" />
            </DockPanel>
        </Border>

        <Grid Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,20,0">
                <!-- The badge, and how far the next level is -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                        <RadioButton Style="{DynamicResource AtrioPill}" GroupName="AtrioCardsSet" Content="{DynamicResource LOCAtrioCardsNormal}" IsChecked="{Binding ShowsNormal}" />
                        <RadioButton Style="{DynamicResource AtrioPill}" GroupName="AtrioCardsSet" Content="{DynamicResource LOCAtrioCardsFoil}" IsChecked="{Binding ShowsFoil}" />
                    </StackPanel>
                    <Grid DockPanel.Dock="Left" Width="88" Height="88" Margin="0,0,18,0">
                        <Ellipse StrokeThickness="2" StrokeDashArray="3 3" Stroke="{DynamicResource AtrioBorderBrush}" Margin="6"
                                 Visibility="{Binding Panel.HasIcon, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                        <Image controls:WebImage.DecodeWidth="176" controls:WebImage.Url="{Binding Panel.IconUrl}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Panel.HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Panel.BadgeTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AtrioDisplayFont}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Panel.BadgeText}" Style="{DynamicResource AtrioCaption}" FontSize="13"
                                   Visibility="{Binding Panel.BadgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Panel.Badge.UnlockedText}" Style="{DynamicResource AtrioCaption}" FontSize="13"
                                   Visibility="{Binding Panel.Badge.UnlockedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Panel.NextText}" Style="{DynamicResource AtrioCaption}" FontSize="13"
                                   Visibility="{Binding Panel.NextText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Panel.CardsText}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="13" />
                            <TextBlock Text="{Binding Panel.DropsText, StringFormat=' · {0}'}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="13"
                                       Visibility="{Binding Panel.DropsText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Panel.EmptyText}" Style="{DynamicResource AtrioCaption}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding Panel.EmptyText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Panel.Tiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource AtrioPlainButton}" Margin="0,0,14,14" Width="132" ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding ToolTip}"
                                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:WindowBase}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Image x:Name="Picture" controls:WebImage.DecodeWidth="264" controls:WebImage.Url="{Binding ImageUrl}"
                                                   Height="154" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border x:Name="Count" CornerRadius="9" Padding="7,1,7,2" Margin="4" Background="{DynamicResource AtrioPlayBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Visibility="{Binding CountText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AtrioPlayTextBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="Name" Text="{Binding Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOwned}" Value="False">
                                        <Setter TargetName="Picture" Property="Opacity" Value="0.32" />
                                        <Setter TargetName="Name" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- The chosen card, big -->
            <Border Grid.Column="1" Style="{DynamicResource AtrioCard}" VerticalAlignment="Top"
                    Visibility="{Binding HasChosen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Image controls:WebImage.DecodeWidth="640" controls:WebImage.Fallback="{Binding Chosen.ImageUrl}" controls:WebImage.Url="{Binding PictureUrl}" Stretch="Uniform" MaxHeight="430"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Chosen.Name}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="17" FontWeight="SemiBold"
                               FontFamily="{DynamicResource AtrioDisplayFont}" TextWrapping="Wrap" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding Chosen.ToolTip}" Style="{DynamicResource AtrioCaption}" TextWrapping="Wrap" />
                    <Button Style="{DynamicResource AtrioGhostButton}" Content="{DynamicResource LOCAtrioCardMarket}" Margin="0,12,0,0" HorizontalAlignment="Left"
                            MinHeight="30" FontSize="12" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ChosenMarketUrl}"
                            Visibility="{Binding ChosenMarketUrl, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</controls:WindowBase>
