<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.StoreChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
        mc:Ignorable="d"
        Style="{DynamicResource StandardWindowStyle}"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Width="520" MaxHeight="680" ShowTitle="False"
        ShowMinimizeButton="False" ShowMaximizeButton="False"
        Name="WindowStoreChooser">

    <controls:WindowBase.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </controls:WindowBase.InputBindings>

    <StackPanel>
        <!-- The game in big, the question over it -->
        <Grid Height="168">
            <Image Source="{Binding HeaderImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="Fant" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33000000" Offset="0" />
                        <GradientStop Color="{DynamicResource MainColorDark}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,12">
                <TextBlock Text="{Binding GameName}" FontSize="24" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource AtrioDisplayFont}" />
                <TextBlock Text="{Binding Question}" FontSize="14" Foreground="#E6FFFFFF" TextWrapping="Wrap"
                           FontFamily="{DynamicResource FontFamily}" />
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Copies}" Focusable="False" Margin="24,12,24,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,0,10" Cursor="Hand" CommandParameter="{Binding}"
                            Command="{Binding DataContext.SelectCommand, ElementName=WindowStoreChooser}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border CornerRadius="{DynamicResource AtrioCardRadius}" Background="{DynamicResource AtrioCardBrush}" />
                                    <Border x:Name="Card" CornerRadius="{DynamicResource AtrioCardRadius}" Background="{Binding CardBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource AtrioBorderBrush}" Padding="14,10,14,10">
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding StoreIcon}" Width="34" Height="34"
                                                   RenderOptions.BitmapScalingMode="Fant" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AtrioPlayBrush}" VerticalAlignment="Center"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,7,16,7">
                                                <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold" FontSize="13"
                                                           FontFamily="{DynamicResource FontFamily}"
                                                           Foreground="{DynamicResource AtrioPlayTextBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StoreName}" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                                           FontFamily="{DynamicResource AtrioDisplayFont}" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextBrushDarker}" FontSize="12"
                                                           FontFamily="{DynamicResource FontFamily}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox Margin="24,6,24,20" IsChecked="{Binding Remember}" Content="{DynamicResource LOCAtrioChooserRemember}" />
    </StackPanel>
</controls:WindowBase>
