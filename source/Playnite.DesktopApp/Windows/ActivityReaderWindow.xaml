<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.ActivityReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
        mc:Ignorable="d"
        d:DesignStyle="{StaticResource WindowDesignStyle}"
        Style="{DynamicResource StandardWindowStyle}"
        Title="{Binding WindowTitle}" Height="900" Width="1060"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource WindowPanelSeparatorBrush}">
            <DockPanel LastChildFill="True" Margin="5">
                <Button Content="{DynamicResource LOCCloseLabel}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" />
                <Button Content="{DynamicResource LOCAtrioActivityOpenWeb}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Right" Command="{Binding OpenWebCommand}" />
                <Button Content="{DynamicResource LOCAtrioActivityNewer}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Left" Command="{Binding PreviousCommand}" />
                <Button Content="{DynamicResource LOCAtrioActivityOlder}" Style="{StaticResource BottomButton}"
                        DockPanel.Dock="Left" Command="{Binding NextCommand}" />
                <TextBlock Text="{Binding InfoText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="860" Margin="32,24,32,32">
                <Image controls:WebImage.DecodeWidth="1400" controls:WebImage.Url="{Binding ImageUrl}" MaxHeight="420"
                       Stretch="UniformToFill" HorizontalAlignment="Center" Margin="0,0,0,18"
                       Visibility="{Binding ImageUrl, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GlyphBrush}"
                               FontFamily="{DynamicResource FontFamily}" />
                    <TextBlock Text="{Binding DateText}" Style="{DynamicResource AtrioCaption}" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding PostTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="28" FontWeight="SemiBold"
                           FontFamily="{DynamicResource AtrioDisplayFont}" TextWrapping="Wrap" Margin="0,6,0,16" />
                <controls:HtmlTextView x:Name="Body" PartialLoadEnabled="False" HtmlText="{Binding Html}" HtmlFontSize="15" HtmlFontFamily="{DynamicResource FontFamily}"
                                       HtmlForeground="{DynamicResource TextColor}" LinkForeground="{DynamicResource GlyphColor}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</controls:WindowBase>
