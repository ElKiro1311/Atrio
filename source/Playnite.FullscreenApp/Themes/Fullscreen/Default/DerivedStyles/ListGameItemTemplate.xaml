<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Small store icons over a cover, from the most to the least relevant store -->
    <Style x:Key="CoverStoreBadges" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Width="28" Height="28" CornerRadius="7" Margin="4,0,0,0" Background="#B8000000">
                        <Image Source="{Binding StoreIcon}" Width="19" Height="19"
                               RenderOptions.BitmapScalingMode="Fant" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource CoverRadius}">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="14"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="{DynamicResource FontSizeSmall}" />
                        </Border>
                        <Image x:Name="PART_ImageCover"
                               RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Stretch="{Settings CoverArtStretch}"
                               RoundedClip.Radius="{DynamicResource CoverClipRadius}" />
                        <Border Background="#99000000" x:Name="BorderDarken" Visibility="Collapsed"
                                CornerRadius="{DynamicResource CoverRadius}" />
                        <ItemsControl ItemsSource="{Binding StoreBadges}" Style="{DynamicResource CoverStoreBadges}" />
                        <Border Visibility="{Settings Fullscreen.ShowGameTitles}" VerticalAlignment="Bottom"
                                Background="#CC000000" CornerRadius="0,0,12,12">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       TextAlignment="Center" Padding="8,5,8,6" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
