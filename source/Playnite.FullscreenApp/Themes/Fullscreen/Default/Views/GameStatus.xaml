<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="ButtonGameStatusAction" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="6,5,6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="220" />
    </Style>

    <Style TargetType="{x:Type GameStatus}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameStatus}">
                    <Grid Background="{DynamicResource MainBackgourndBrush}"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <FadeImage Grid.RowSpan="7" Stretch="Fill" Source="{Binding Game.DisplayBackgroundImageObject}"
                                   UseBlurredCopy="True" IsBlurEnabled="True" BlurAmount="200"
                                   Opacity="0.5" IsHitTestVisible="False" />
                        <Border Grid.RowSpan="7" Background="#8C080A0F" IsHitTestVisible="False" />

                        <Image Name="PART_ImageCover" Grid.Row="1"
                               RenderOptions.BitmapScalingMode="Fant"
                               Height="400" HorizontalAlignment="Center"
                               RoundedClip.Radius="{DynamicResource CoverClipRadius}" />

                        <!-- The wheel turns while the game starts; once it's open there's nothing to wait for. -->
                        <Border Grid.Row="2" Margin="0,30,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding CanReturn, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                            <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False" Height="36" Width="36" />
                        </Border>

                        <TextBlock Name="PART_TextStatus" TextWrapping="Wrap" Grid.Row="3"
                                   Style="{StaticResource TextBlockBaseStyle}"
                                   FontFamily="{DynamicResource FontTitilliumWeb}" FontSize="26"
                                   TextAlignment="Center" MaxWidth="1100"
                                   HorizontalAlignment="Center" Margin="0,20,0,26" />

                        <StackPanel Name="PART_PanelActionButtons" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Grid.Row="4" />

                        <TextBlock Grid.Row="5" Text="{Binding ReturnHint}" TextWrapping="Wrap"
                                   Style="{StaticResource TextBlockBaseStyle}" Opacity="0.7"
                                   FontSize="18" TextAlignment="Center" MaxWidth="1100"
                                   HorizontalAlignment="Center" Margin="0,22,0,0"
                                   Visibility="{Binding CanReturn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
