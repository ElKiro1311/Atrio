<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- One fact about the selected game: an icon and a text -->
    <Style x:Key="GameFactText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWeb}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GameFactIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontIcoFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,9,0" />
    </Style>

    <!-- Store icons next to the facts of a game -->
    <Style x:Key="GameFactStores" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,7,0" Background="{DynamicResource HoverBrush}">
                        <Image Source="{Binding StoreIcon}" Width="23" Height="23"
                               RenderOptions.BitmapScalingMode="Fant" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What the view says about the selected game, on the art or above the grid -->
    <DataTemplate x:Key="GameFactsTemplate">
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding SelectedGame.StoreBadges}" Style="{DynamicResource GameFactStores}" Margin="0,0,14,0" />

            <StackPanel Orientation="Horizontal" Margin="0,0,30,0"
                        Visibility="{Binding SelectedGame.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Ellipse Width="11" Height="11" Fill="{DynamicResource PositiveBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{DynamicResource LOCGameIsInstalledTitle}" Style="{DynamicResource GameFactText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,30,0"
                        Visibility="{Binding SelectedGame.PlaytimeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="&#xedcd;" Style="{DynamicResource GameFactIcon}" />
                <TextBlock Text="{Binding SelectedGame.PlaytimeText}" Style="{DynamicResource GameFactText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding SelectedGame.LastActivity, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="&#xec45;" Style="{DynamicResource GameFactIcon}" />
                <TextBlock Text="{Binding SelectedGame.LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}"
                           Style="{DynamicResource GameFactText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Behind the grid, the colors of the game: it's a very small picture -->
                            <FadeImage x:Name="PART_ImageAmbient" Grid.RowSpan="3" Stretch="Fill"
                                       UseBlurredCopy="True" IsBlurEnabled="True" BlurAmount="200" FadeSeconds="0.2"
                                       Opacity="0.22" IsHitTestVisible="False" />

                            <!-- The art itself -->
                            <Grid x:Name="ArtHost" Grid.RowSpan="3" VerticalAlignment="Top" Height="860" ClipToBounds="True" IsHitTestVisible="False">
                                <FadeImage x:Name="PART_ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FadeSeconds="0.2" />
                                <Border Background="{DynamicResource ArtSideShadeBrush}" />
                            </Grid>
                            <Border x:Name="ArtBottomShade" Grid.RowSpan="3" Background="{DynamicResource ArtBottomShadeBrush}" IsHitTestVisible="False" />

                            <Grid Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}" Height="104">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource ViewInset}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource ViewInset}" />
                                </Grid.ColumnDefinitions>

                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Focusable="False"
                                                Height="27" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Column="1" />

                                <DockPanel Grid.Column="2" HorizontalAlignment="Left" Margin="0,0,30,0">
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Focusable="False" DockPanel.Dock="Right"
                                                    Height="27" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <FilterPresetSelector x:Name="PART_FilterPresetSelector" VerticalAlignment="Center" />
                                </DockPanel>

                                <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="34"
                                            VerticalAlignment="Center" Margin="10,0,6,0"
                                            Grid.Column="3">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <TextBlock x:Name="PART_TextBatteryPercentage" Style="{DynamicResource TextBlockBaseStyle}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Grid.Column="4"/>

                                <TextBlock x:Name="PART_TextClock" Style="{DynamicResource TextBlockBaseStyle}"
                                       FontFamily="{DynamicResource FontTitilliumWeb}" FontSize="24"
                                       VerticalAlignment="Center" Margin="14,0,20,0"
                                       Grid.Column="5"/>

                                <ButtonEx x:Name="PART_ButtonProgramUpdate" VerticalAlignment="Center"
                                          Margin="4,0,4,0" Height="52" MinWidth="52"
                                          Style="{DynamicResource ButtonTopMenu}"
                                          Grid.Column="6">
                                    <ButtonEx.Content>
                                        <TextBlock Text="&#xef08;" FontFamily="{StaticResource FontIcoFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GlyphLightBrush}" FontSize="27" />
                                    </ButtonEx.Content>
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center"
                                          Margin="4,0,4,0" Height="52" MinWidth="52"
                                          Grid.Column="7">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="&#xeea3;" FontFamily="{StaticResource FontIcoFont}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="27" />
                                            <Ellipse Width="11" Height="11" Fill="{DynamicResource GlyphBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,9,0" />
                                        </Grid>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonTopMenu}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center"
                                          Style="{DynamicResource ButtonTopMenu}"
                                          Margin="4,0,0,0" Height="52" MinWidth="52"
                                          Grid.Column="8">
                                    <Button.Content>
                                        <Image RenderOptions.BitmapScalingMode="Fant" Margin="5"
                                           Source="{ThemeFile 'Images/applogo_clean.png'}" />
                                    </Button.Content>
                                </ButtonEx>
                            </Grid>

                            <DockPanel Grid.Row="1">
                                <Filters x:Name="PART_ElemFilters"
                                         DockPanel.Dock="Left" Focusable="False" />

                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional"
                                                   DockPanel.Dock="Left" Focusable="False" />

                                <ContentControl x:Name="PART_ContentFilterItems"
                                            DockPanel.Dock="Left" Focusable="False" />

                                <Grid DockPanel.Dock="Right">
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="RowGameInfo" Height="Auto" />
                                        <RowDefinition x:Name="RowGames" Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- The selected game. On the art it has the whole space, over the grid just a line. -->
                                    <StackPanel x:Name="GameInfo" Orientation="Horizontal" Margin="96,10,96,4" VerticalAlignment="Bottom">
                                        <Grid x:Name="GameTitleHost" HorizontalAlignment="Left">
                                            <TextBlock x:Name="GameTitle" Text="{Binding SelectedGame.DisplayName}"
                                                       Style="{DynamicResource TextBlockCaptionStyle}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="1200">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.6" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Image x:Name="GameLogo" Source="{Binding LogoImage}" Visibility="Collapsed"
                                                   MaxHeight="190" MaxWidth="640" Stretch="Uniform" StretchDirection="DownOnly"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                   RenderOptions.BitmapScalingMode="Fant">
                                                <Image.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.55" />
                                                </Image.Effect>
                                            </Image>
                                        </Grid>
                                        <ContentControl x:Name="GameFacts" ContentTemplate="{DynamicResource GameFactsTemplate}" Content="{Binding}" Focusable="False"
                                                        Margin="28,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBoxEx x:Name="PART_ListGameItems" Grid.Row="1"
                                               Background="Transparent" BorderThickness="0"
                                               ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                               ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                               KeyboardNavigation.DirectionalNavigation="Once" />

                                    <TextBlock Grid.Row="1" FontSize="34"
                                               Text="{DynamicResource LOCNoGamesFound}"
                                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>

                            <Grid Grid.Row="2" Height="92">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource ViewInset}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource ViewInset}" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!--Install-->
                                    <ButtonEx x:Name="PART_ButtonInstall"
                                              Style="{DynamicResource ButtonBottomPrimary}"
                                              Content="{DynamicResource LOCInstallGame}" />
                                    <!--Play-->
                                    <ButtonEx x:Name="PART_ButtonPlay"
                                              Style="{DynamicResource ButtonBottomPrimary}"
                                              Content="{DynamicResource LOCPlayGame}" />
                                    <!--Details-->
                                    <ButtonEx x:Name="PART_ButtonDetails"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameDetails}" />
                                    <!--Options-->
                                    <ButtonEx x:Name="PART_ButtonGameOptions"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameOptions}" />
                                    <!--Search-->
                                    <ButtonEx x:Name="PART_ButtonSearch"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCSearchLabel}" />
                                    <!--Filter-->
                                    <ButtonEx x:Name="PART_ButtonFilter"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCFilter}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" x:Name="PART_ElemSearchActive" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0">
                                    <TextBlock Style="{DynamicResource TextBlockSecondaryStyle}" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Text="{DynamicResource LOCGameListSearchResults}"/>
                                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="20"
                                               FontFamily="{DynamicResource FontTitilliumWeb}" VerticalAlignment="Center"
                                               Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" x:Name="PART_ElemExtraFilterActive"
                                       FontSize="20" Margin="0,0,24,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Style="{DynamicResource TextBlockSecondaryStyle}"
                                       Text="{DynamicResource LOCGameListExtraFiltered}"/>

                                <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal"
                                        Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="PART_TextProgressTooltip"
                                           Margin="0,0,15,0" FontSize="20" VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlockSecondaryStyle}"/>
                                    <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                Height="34" Width="34" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <GameStatus x:Name="PART_ElemGameStatus" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Grid: the art is too much behind so many covers -->
                        <DataTrigger Binding="{Binding ShowcaseActive}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ArtHost" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ArtBottomShade" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowcaseActive}" Value="True">
                            <Setter Property="Height" Value="*" TargetName="RowGameInfo" />
                            <Setter Property="Height" Value="330" TargetName="RowGames" />
                            <Setter Property="Orientation" Value="Vertical" TargetName="GameInfo" />
                            <Setter Property="Margin" Value="96,0,96,22" TargetName="GameInfo" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="GameFacts" />
                            <Setter Property="FontSize" Value="58" TargetName="GameTitle" />
                            <Setter Property="TextWrapping" Value="Wrap" TargetName="GameTitle" />
                            <Setter Property="MaxHeight" Value="190" TargetName="GameTitle" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Hidden" TargetName="GameInfo" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowcaseActive}" Value="True" />
                                <Condition Binding="{Binding HasLogo}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="GameLogo" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="GameTitle" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
