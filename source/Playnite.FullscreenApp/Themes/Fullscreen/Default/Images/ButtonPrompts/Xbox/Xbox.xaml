<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Drawn for Atrio: every button is a plain shape with its label. -->

    <DataTemplate x:Key="ButtonPromptA">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <TextBlock Text="A" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptB">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <TextBlock Text="B" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptX">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <TextBlock Text="X" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptY">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <TextBlock Text="Y" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptLB">
        <Viewbox>
            <Grid Width="62" Height="36">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="10" />
                <TextBlock Text="LB" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptRB">
        <Viewbox>
            <Grid Width="62" Height="36">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="10" />
                <TextBlock Text="RB" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptLT">
        <Viewbox>
            <Grid Width="54" Height="40">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="16,16,8,8" />
                <TextBlock Text="LT" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptRT">
        <Viewbox>
            <Grid Width="54" Height="40">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="16,16,8,8" />
                <TextBlock Text="RT" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptBack">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Grid Width="22" Height="18">
                    <Rectangle Stroke="{DynamicResource FocusTextBrush}" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Width="15" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" RadiusX="2" RadiusY="2" Width="15" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptStart">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Grid Width="20" Height="16">
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Top" />
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptLS">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Stroke="{DynamicResource FocusBrush}" StrokeThickness="3" />
                <Ellipse Fill="{DynamicResource FocusBrush}" Margin="6" />
                <TextBlock Text="L" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="15" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptRS">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Stroke="{DynamicResource FocusBrush}" StrokeThickness="3" />
                <Ellipse Fill="{DynamicResource FocusBrush}" Margin="6" />
                <TextBlock Text="R" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="15" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
