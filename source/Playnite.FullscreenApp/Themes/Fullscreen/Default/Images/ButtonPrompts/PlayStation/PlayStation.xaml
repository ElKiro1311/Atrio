<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Drawn for Atrio: every button is a plain shape with its label. -->

    <DataTemplate x:Key="ButtonPromptA">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Path Data="M0,0 L16,16 M16,0 L0,16" Stroke="{DynamicResource FocusTextBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptB">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Ellipse Stroke="{DynamicResource FocusTextBrush}" StrokeThickness="3.2" Width="19" Height="19" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptX">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Rectangle Stroke="{DynamicResource FocusTextBrush}" StrokeThickness="3.2" RadiusX="1.5" RadiusY="1.5" Width="18" Height="18" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptY">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Path Data="M10,1 L19,17 L1,17 Z" Stroke="{DynamicResource FocusTextBrush}" StrokeThickness="3" StrokeLineJoin="Round" Width="20" Height="18" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptLB">
        <Viewbox>
            <Grid Width="62" Height="36">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="10" />
                <TextBlock Text="L1" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptRB">
        <Viewbox>
            <Grid Width="62" Height="36">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="10" />
                <TextBlock Text="R1" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptLT">
        <Viewbox>
            <Grid Width="54" Height="40">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="16,16,8,8" />
                <TextBlock Text="L2" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptRT">
        <Viewbox>
            <Grid Width="54" Height="40">
                <Border Background="{DynamicResource FocusBrush}" CornerRadius="16,16,8,8" />
                <TextBlock Text="R2" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptBack">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Grid Width="22" Height="18">
                    <Rectangle Stroke="{DynamicResource FocusTextBrush}" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Width="15" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" RadiusX="2" RadiusY="2" Width="15" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptStart">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource FocusBrush}" />
                <Grid Width="20" Height="16">
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Top" />
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />
                    <Rectangle Fill="{DynamicResource FocusTextBrush}" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptLS">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Stroke="{DynamicResource FocusBrush}" StrokeThickness="3" />
                <Ellipse Fill="{DynamicResource FocusBrush}" Margin="6" />
                <TextBlock Text="L3" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="15" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ButtonPromptRS">
        <Viewbox>
            <Grid Width="40" Height="40">
                <Ellipse Stroke="{DynamicResource FocusBrush}" StrokeThickness="3" />
                <Ellipse Fill="{DynamicResource FocusBrush}" Margin="6" />
                <TextBlock Text="R3" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="15" Foreground="{DynamicResource FocusTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
