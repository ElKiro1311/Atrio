<Project>
  <PropertyGroup>
    <!-- Atrio: inherited package versions must stay as they are, add-ons bind to them. -->
    <NuGetAudit>false</NuGetAudit>
    <Company>Atrio</Company>
    <Product>Atrio</Product>
  </PropertyGroup>

  <!-- Atrio: test builds only. Adds the off-screen harness, a normal build does not have it. -->
  <PropertyGroup Condition="'$(AtrioBanco)'=='true'">
    <DefineConstants>$(DefineConstants);ATRIO_BANCO</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- This generator is super slow (slows down our compile time by almost 3x)
       and we don't actually need it for anything because we are not doing WinRT related stuff. -->
  <Target Name="DisableWinRTSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(FileName)%(Extension)' == 'WinRT.SourceGenerator.dll'"/>
    </ItemGroup>
  </Target>
</Project>