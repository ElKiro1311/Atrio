<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Solid panel fixed to the edge of the window -->
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border Width="{DynamicResource AtrioSidebarWidth}" Background="{DynamicResource AtrioSidebarBrush}">
                        <DockPanel Margin="12,16,12,12">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand"
                                    DockPanel.Dock="Top" Padding="6,4,6,4" Margin="0,0,0,22"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <DockPanel>
                                    <Image Source="{ThemeFile 'Images/applogo.png'}" Width="28" Height="28"
                                           RenderOptions.BitmapScalingMode="Fant" DockPanel.Dock="Left" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource AtrioIconFont}" FontSize="9"
                                               Foreground="{DynamicResource TextBrushDarker}"
                                               VerticalAlignment="Center" DockPanel.Dock="Right" />
                                    <TextBlock Text="ATRIO" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                                               FontFamily="{DynamicResource AtrioDisplayFont}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="PART_PanelSideBarBottomItems" Orientation="Vertical" DockPanel.Dock="Bottom" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          CanContentScroll="True" x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
