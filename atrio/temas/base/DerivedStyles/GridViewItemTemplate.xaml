<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <StackPanel Name="PART_PanelHost" Background="Transparent"
                                d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                            <Border x:Name="Glow" CornerRadius="{DynamicResource AtrioCardRadius}" Background="{DynamicResource AtrioCardBrush}">
                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                           VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}" />
                            </Border>

                            <Image Name="PART_ImageCover"
                                   RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stretch="{Settings CoverArtStretch}"
                                   RoundedClip.Radius="{DynamicResource AtrioCoverRadius}" />

                            <!-- Only on hover: the cover darkens from below and the title rises over it -->
                            <Border x:Name="Shade" CornerRadius="{DynamicResource AtrioCardRadius}" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1A000000" Offset="0" />
                                        <GradientStop Color="#33000000" Offset="0.45" />
                                        <GradientStop Color="#F2000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Dot that marks a game ready to play -->
                            <Border x:Name="InstalledDot" Width="11" Height="11" CornerRadius="6" Margin="9"
                                    Background="#3DDC84" BorderBrush="#B3000000" BorderThickness="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                                    ToolTip="{DynamicResource LOCAtrioCopyInstalled}" />

                            <Button Name="PART_ButtonPlay" Width="56" Height="56" Cursor="Hand" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Round" CornerRadius="28" Background="{DynamicResource AtrioPlayBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.6" />
                                            </Border.Effect>
                                            <TextBlock x:Name="Glyph" Text="&#xE768;" FontFamily="{DynamicResource AtrioIconFont}" FontSize="22"
                                                       Foreground="{DynamicResource AtrioPlayTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE896;" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Round" Property="Background" Value="{DynamicResource AtrioPlayHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock x:Name="HoverPlaytime" Text="{Binding PlaytimeText}" Foreground="#CCFFFFFF" FontSize="12" Visibility="Collapsed"
                                       FontFamily="{DynamicResource FontFamily}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,9" />

                            <ItemsControl ItemsSource="{Binding StoreBadges}" Style="{DynamicResource AtrioStoreBadges}" />

                            <Border x:Name="Outline" CornerRadius="{DynamicResource AtrioCardRadius}" BorderThickness="2" BorderBrush="Transparent" />
                        </Grid>

                        <TextBlock x:Name="GameName" Text="{Binding DisplayName}"
                                   Style="{DynamicResource BaseTextBlockStyle}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" Padding="3,8,3,4"
                                   Width="{Settings GridItemWidth}"
                                   Visibility="{Settings ShowNamesUnderCovers}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter TargetName="InstalledDot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_ImageCover" Property="Opacity" Value="0.55" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ButtonPlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlaytime" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="GameName" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="26" Opacity="0.75" Color="{DynamicResource GlyphColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
