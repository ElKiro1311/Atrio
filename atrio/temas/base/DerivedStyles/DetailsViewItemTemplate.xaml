<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="DetailsViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border Name="PART_PanelHost" Padding="6,2,6,2" Background="Transparent"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <DockPanel>
                            <Image Name="PART_ImageIcon"
                                   Height="{Settings DetailsViewListIconSize}"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding StoreBadges}" DockPanel.Dock="Right" Focusable="False"
                                          VerticalAlignment="Center" Margin="6,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding StoreIcon}" Width="14" Height="14" Margin="3,0,0,0"
                                               RenderOptions.BitmapScalingMode="Fant" ToolTip="{Binding StoreName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Like Steam: an open game goes green with "- Running" after its name, which only shortens the name. -->
                            <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- Steam has an update waiting for it, which installs when the game closes: it takes the place
                                     of "- Running" so the name keeps its room, and the green name still says it is open. -->
                                <TextBlock x:Name="UpdateMark" DockPanel.Dock="Right" Text="{DynamicResource LOCAtrioUpdatePendingListMark}"
                                           Foreground="{DynamicResource WarningBrush}" FontSize="13" Margin="4,0,0,0"
                                           ToolTip="{DynamicResource LOCAtrioUpdatePendingHint}" Visibility="Collapsed" />
                                <TextBlock x:Name="OpenMark" DockPanel.Dock="Right" Text="{DynamicResource LOCAtrioOpenMark}"
                                           Foreground="{DynamicResource AtrioOpenBrush}" FontSize="13" Margin="4,0,0,0"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="GameName" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="13" />
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter TargetName="OpenMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GameName" Property="Foreground" Value="{DynamicResource AtrioOpenBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding UpdatePending}" Value="True">
                            <Setter TargetName="UpdateMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OpenMark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
