<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The notice of an achievement while playing, with the look of the themes of Atrio: a card like the
        one of an achievement on a game page, with the color of its rarity on the left edge.
        The add-on of the achievements takes it from the folder of the active theme by its key, as long as
        "use the template of my theme" is on in its settings, which it is by default. The theme Clásico
        has no such file, so it keeps the notice of the add-on.
        The data is the notice of the add-on (AchievementToastViewModel); only plain bindings are used,
        so that nothing here depends on its resources.
    -->
    <BooleanToVisibilityConverter x:Key="AtrioToastVisible" />

    <DataTemplate x:Key="PlayAch.Template.AchievementToast">
        <Border Width="{Binding ToastCardWidth}" MinHeight="76" Margin="{Binding ToastGlowMargin}"
                Background="@@popup@@" BorderBrush="@@borde@@" BorderThickness="1" CornerRadius="@@radioTarjeta@@"
                TextElement.FontFamily="@@fuente@@" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
            </Border.Effect>
            <Grid>
                <!-- The rarity, at a glance -->
                <Border x:Name="Strip" Width="4" HorizontalAlignment="Left" Margin="0,12,0,12" CornerRadius="0,2,2,0"
                        Background="{Binding RarityBrush}" />
                <DockPanel Margin="16,12,16,12">
                    <Border DockPanel.Dock="Left" Width="58" Height="58" Margin="0,0,14,0" VerticalAlignment="Center"
                            CornerRadius="8" Background="#14FFFFFF">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,58,58" RadiusX="8" RadiusY="8" />
                        </Border.Clip>
                        <Image Source="{Binding IconImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock x:Name="Header" DockPanel.Dock="Left" Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="@@acento@@" />
                            <TextBlock x:Name="Separator" DockPanel.Dock="Left" Text="·" Margin="7,0,7,0" FontSize="11" Foreground="@@textoTenue@@" />
                            <TextBlock x:Name="Game" Text="{Binding GameName}" FontSize="11" Foreground="@@textoTenue@@" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock x:Name="Title" Text="{Binding TitleText}" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold"
                                   Foreground="@@texto@@" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Description" Text="{Binding Description}" Margin="0,2,0,0" FontSize="12" LineHeight="16"
                                   Foreground="@@textoTenue@@" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="Rarity" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0"
                                       Foreground="{Binding RarityBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PercentText}" FontSize="11" Foreground="@@textoTenue@@" VerticalAlignment="Center" />
                        </StackPanel>
                        <DockPanel x:Name="Progress" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="10,0,0,0" FontSize="11"
                                       Foreground="@@textoTenue@@" VerticalAlignment="Center" />
                            <Grid Height="4" VerticalAlignment="Center">
                                <Border Background="#26FFFFFF" CornerRadius="2" />
                                <Border Background="@@acento@@" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                                    <Border.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding ProgressFraction}" />
                                    </Border.LayoutTransform>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding GameName}" Value="">
                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GameName}" Value="{x:Null}">
                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Description}" Value="">
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PercentText}" Value="">
                <Setter TargetName="Rarity" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!-- A step towards one that counts something: how far the player is, instead of how rare it is -->
            <DataTrigger Binding="{Binding IsProgressUpdate}" Value="True">
                <Setter TargetName="Progress" Property="Visibility" Value="Visible" />
                <Setter TargetName="Rarity" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!-- The whole game done: the congratulations, the name of the game and the accent instead of the rarity -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsGameCompleted}" Value="True" />
                    <Condition Binding="{Binding IsFriendUnlock}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Header" Property="Text" Value="{Binding CompletionHeaderText}" />
                <Setter TargetName="Title" Property="Text" Value="{Binding CompletionTitleText}" />
                <Setter TargetName="Strip" Property="Background" Value="@@acento@@" />
                <Setter TargetName="Rarity" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsGameCompleted}" Value="True" />
                    <Condition Binding="{Binding IsFriendUnlock}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Header" Property="Text" Value="{Binding FriendCompletionHeaderText}" />
                <Setter TargetName="Title" Property="Text" Value="{Binding CompletionTitleText}" />
                <Setter TargetName="Rarity" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
