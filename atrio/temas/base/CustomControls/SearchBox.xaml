<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextInpuText" VerticalContentAlignment="Center" Padding="32,0,28,0"
                                 Background="{DynamicResource AtrioCardBrush}" BorderBrush="{DynamicResource AtrioBorderBrush}" />
                        <TextBlock Text="{DynamicResource LOCAtrioSearchHint}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="34,0,0,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextInpuText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ContentControl x:Name="PART_SeachIcon"
                                        ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"
                                        IsHitTestVisible="False" Foreground="{DynamicResource TextBrushDarker}" />
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                        FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,9,0"
                                        Foreground="{DynamicResource TextBrushDarker}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
