<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type MainWindow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MainWindow}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            d:DesignWidth="1280" d:DesignHeight="960">
                        <Grid>
                            <!-- The art of the game in focus, blurred until only its colors remain -->
                            <FadeImage Source="{Binding AmbientImage}" Stretch="UniformToFill" Opacity="@@ambiente@@" FadeSeconds="0.2"
                                       IsBlurEnabled="True" BlurAmount="60" UseBlurredCopy="True"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" />
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="@@veloSuperior@@" Offset="0" />
                                        <GradientStop Color="@@veloInferior@@" Offset="0.8" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <DockPanel>
                                <!-- Not a named part on purpose: this row holds the menu and it can't be hidden -->
                                <Sidebar Panel.ZIndex="999" DockPanel.Dock="Top" />
                                <ContentControl Name="PART_ContentView" DockPanel.Dock="Top" />
                            </DockPanel>
                            <!-- The messages open in the popup of the bell, in the top bar. -->
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
