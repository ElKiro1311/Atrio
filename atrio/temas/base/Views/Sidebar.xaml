<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <!-- Floating panel: the color of the window shows around and through it -->
                    <Border Width="{DynamicResource AtrioSidebarWidth}" Margin="10,10,0,10"
                            CornerRadius="16" Background="{DynamicResource AtrioSidebarBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource AtrioBorderBrush}">
                        <DockPanel Margin="10,12,10,10">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand"
                                    DockPanel.Dock="Top" Padding="6,6,6,6" Margin="0,0,0,20"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <DockPanel>
                                    <Image Source="{ThemeFile 'Images/applogo.png'}" Width="30" Height="30"
                                           RenderOptions.BitmapScalingMode="Fant" DockPanel.Dock="Left" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource AtrioIconFont}" FontSize="10"
                                               Foreground="{DynamicResource TextBrushDarker}"
                                               VerticalAlignment="Center" DockPanel.Dock="Right" />
                                    <TextBlock Text="Atrio" FontSize="21" FontWeight="SemiBold" Margin="10,1,0,0"
                                               FontFamily="{DynamicResource AtrioDisplayFont}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <StackPanel x:Name="PART_PanelSideBarBottomItems" Orientation="Vertical" DockPanel.Dock="Bottom" />

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          CanContentScroll="True" x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
