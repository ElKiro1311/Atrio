<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Navigation along the top, as a row of words, with the tools at the other end -->
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border Height="52" Background="{DynamicResource AtrioSidebarBrush}"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AtrioBorderBrush}">
                        <DockPanel Margin="14,0,140,0">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand" DockPanel.Dock="Left"
                                    Margin="0,0,14,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{ThemeFile 'Images/applogo.png'}" Width="28" Height="28"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource AtrioIconFont}" FontSize="9" Margin="7,0,0,0"
                                               Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TopPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Horizontal" />
                                    <StackPanel x:Name="PART_PanelSideBarBottomItems" Orientation="Horizontal" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
