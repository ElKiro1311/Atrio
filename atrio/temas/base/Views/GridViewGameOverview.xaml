<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Grid Background="{DynamicResource NormalBrushDark}">
@@incluir:_pagina_juego.xaml@@
                        <Button Style="{DynamicResource AtrioGhostButton}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#B3101218" Foreground="White"
                                Margin="36,12,0,0" Command="{MainViewModel CloseGameSideBarCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource AtrioIconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOCAtrioBack}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
@@incluir:_pestana_logros.xaml@@
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
