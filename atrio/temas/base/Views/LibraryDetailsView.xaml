<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type LibraryDetailsView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type LibraryDetailsView}">
                    <DockPanel d:DesignWidth="1280" d:DesignHeight="960"
                               d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <!-- The library always on the left: start page, which stores, search and the games -->
                        <Border DockPanel.Dock="{Settings DetailsListPosition}" Width="{Settings DetailsListWitdh}"
                                Background="{DynamicResource AtrioSidebarBrush}"
                                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource AtrioBorderBrush}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                                    <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource AtrioIconToggle}" Margin="4,0,0,0"
                                                  Content="&#xF0E2;" ToolTip="{DynamicResource LOCAtrioHomeSeeAll}"
                                                  IsChecked="{Binding IsAllGamesPane, Mode=OneWay}" Command="{Binding ShowAllGamesCommand}" />
                                    <ToggleButton Style="{DynamicResource AtrioPickerToggle}"
                                                  IsChecked="{Binding IsHomePane, Mode=OneWay}" Command="{Binding ShowHomeCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource AtrioIconFont}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBlock Text="{DynamicResource LOCAtrioHome}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DockPanel>

                                <StoreFilterBar DockPanel.Dock="Top" />

                                <DockPanel DockPanel.Dock="Top" Margin="10,0,10,8">
                                    <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource AtrioIconToggle}" Margin="4,0,0,0"
                                                  Content="&#xE71C;" ToolTip="{DynamicResource LOCAtrioFiltersTip}"
                                                  Tag="{Binding AppSettings.FilterSettings.IsActive}"
                                                  IsChecked="{Settings FilterPanelVisible, Mode=TwoWay}">
                                        <ToggleButton.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding ClearFiltersCommand}" />
                                        </ToggleButton.InputBindings>
                                    </ToggleButton>
                                    <SearchBox Height="34" Text="{Binding AppSettings.FilterSettings.Name, Mode=TwoWay, Delay=100}"
                                               IsFocused="{Binding SearchOpened, Mode=TwoWay}" />
                                </DockPanel>

                                <Button DockPanel.Dock="Bottom" Style="{DynamicResource AtrioLinkButton}" Margin="14,6,10,10" HorizontalAlignment="Left"
                                        Content="{DynamicResource LOCAtrioAddGame}" Command="{Binding AddCustomGameCommand}" />

                                <Grid>
                                    <ExtendedListBox x:Name="PART_ListGames"
                                                     BorderThickness="0" Padding="6,0,2,8"
                                                     ItemContainerStyle="{DynamicResource DetailsViewItemStyle}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.PanningMode="VerticalOnly">
                                        <ExtendedListBox.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource DetailsViewGroupStyle}" />
                                        </ExtendedListBox.GroupStyle>
                                        <ExtendedListBox.ItemTemplate>
                                            <DataTemplate>
                                                <GameListItem Style="{StaticResource DetailsViewItemTemplate}" />
                                            </DataTemplate>
                                        </ExtendedListBox.ItemTemplate>
                                    </ExtendedListBox>
                                    <TextBlock FontSize="{StaticResource FontSizeLarge}" Margin="0,15,0,0"
                                               Text="{DynamicResource LOCNoItemsFound}" TextWrapping="Wrap"
                                               TextAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGames, Mode=OneWay}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- The rest of the window: the start page, every game or the game picked in the list -->
                        <Grid DockPanel.Dock="Left">
                            <Grid Visibility="{Binding IsGamePane, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DetailsViewGameOverview x:Name="PART_ControlGameView" />
                            </Grid>
                            <Grid Visibility="{Binding IsAllGamesPane, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <LibraryGridView AlwaysActive="True" />
                            </Grid>
                            <HomeView DataContext="{Binding HomeModel}"
                                      Visibility="{Binding DataContext.IsHomePane, RelativeSource={RelativeSource AncestorType={x:Type LibraryDetailsView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
