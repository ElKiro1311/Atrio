<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Narrow rail: the icon on top and its name below it, so nothing is left to guess -->
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border Width="{DynamicResource AtrioSidebarWidth}" Background="{DynamicResource AtrioSidebarBrush}">
                        <DockPanel Margin="6,14,6,10">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand"
                                    DockPanel.Dock="Top" Margin="0,0,0,20" HorizontalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Image Source="{ThemeFile 'Images/applogo.png'}" Width="34" Height="34"
                                       RenderOptions.BitmapScalingMode="Fant" />
                            </Border>
                            <StackPanel x:Name="PART_PanelSideBarBottomItems" Orientation="Vertical" DockPanel.Dock="Bottom" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          CanContentScroll="True" x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
