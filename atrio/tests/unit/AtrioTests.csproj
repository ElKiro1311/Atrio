<Project Sdk="Microsoft.NET.Sdk">
  <!-- Atrio's unit tests. They run against a build of Atrio: first run atrio\tools\build.ps1 and then, in this folder,
       dotnet run -c Release (with the SDK in .tools\dotnet, if there is no other one). -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <NuGetAudit>false</NuGetAudit>
    <UseWpf>true</UseWpf>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AtrioApp Condition="'$(AtrioApp)'==''">..\..\..\output\Atrio</AtrioApp>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\source\Tests\Playnite.Tests\GameUnifierTests.cs" Link="GameUnifierTests.cs" />
